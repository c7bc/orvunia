{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "legacy",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@cadence/components": [
        "../client/components/index.ts"
      ],
      "@cadence/i18n": [
        "../client/i18n/personal.ts"
      ],
      "@cadence/icons": [
        "../client/design/icons.ts"
      ],
      "@cadence/notes-rich": [
        "../client/notes-rich/index.ts"
      ]
    }
  },
  "files": [
    "gaze/vision-types.ts"
  ],
  "include": [
    "**/*.ts"
  ]
}
